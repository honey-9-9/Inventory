# ---------------------------------------------------------------------------
# Copy to .env.local and fill in.
# For local development, `npm run db:start` prints the URL and keys to use.
# For a hosted project: Supabase Dashboard -> Project Settings -> API.
# ---------------------------------------------------------------------------

# Safe to expose to the browser (protected by row level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY - bypasses row level security. Never import this in client code.
# Used exclusively by `npm run db:seed-users`.
SUPABASE_SERVICE_ROLE_KEY=

# Accounts provisioned by `npm run db:seed-users`.
ADMIN_EMAIL=admin@drawer.local
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Drawer Admin

VIEWER_EMAIL=viewer@drawer.local
VIEWER_PASSWORD=change-me-please
VIEWER_NAME=Drawer Viewer
